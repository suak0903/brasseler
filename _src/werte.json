  "<svg viewBox=\"0 0 198.426 198.425\" xmlns=\"http://www.w3.org/2000/svg\" class=\"wert-svg\" role=\"img\"><style type=\"text/css\">.c3{fill:#00975F} .cw{fill:#fff} .gh,.gt{font-family: \"Corporate S OT\", \"CorporateSOT-Regular\", \"CorporateSOT\";} .gh{font-weight:bold;font-size:16px} .gt{fill:#3b4248;font-size:calc(9.75/16 * 16px)} .gw{filter:drop-shadow(0 0 20px rgba(0,0,0,.25))}</style><path d=\"m99.213 198.425c54.7939 0 99.213-44.419 99.213-99.213 0-54.793-44.419-99.212-99.213-99.212s-99.213 44.419-99.213 99.212c0 54.794 44.419 99.213 99.213 99.213\" class=\"cw\" /> <text transform=\"translate(78.9982 72.4068)\" class=\"gh c3\">mutig</text> <g class=\"gt\"> <text transform=\"translate(15.0539 89.5767)\">Unser Mut zur Veränderung sichert unsere</text> <text transform=\"translate(11.3488 101.0718)\">Zukunft. Über unterschiedliche Standpunkte</text> <text transform=\"translate(16.8771 112.5669)\">tauschen wir uns aus, lernen voneinander</text> <text transform=\"translate(15.5119 124.062)\">und sehen Fehler als Chance, noch besser</text> <text transform=\"translate(20.4357 135.5572)\">zu werden. Das ist die Basis für mutiges</text> <text transform=\"translate(33.5304 147.0523)\">Handeln. Wir fordern und fördern</text> <text transform=\"translate(36.2599 158.5474)\">konstruktives, wertschätzendes</text> <text transform=\"translate(52.7667 170.0435)\">Feedback und wachsen</text> <text transform=\"translate(70.7853 181.5386)\">so zusammen.</text> </g> <path d=\"m99.213 53.8581c12.524 0 22.6769-10.153 22.6769-22.677s-10.153-22.677-22.6769-22.677c-12.524 0-22.677 10.153-22.677 22.677s10.153 22.677 22.677 22.677\" class=\"c3\" /> <path d=\"m114.5216 40.0337c-.3994-.2764-.7451-.374-.9971-.4453-.1475-.042-.2646-.0752-.3223-.123-.2324-.1943-1.0117-1.1973-1.1406-1.4121l-.0703-.1172c-.5244-.876-1.2627-2.0879-1.6289-2.4951-.2129-.2354.0156-1.2959.6045-1.8848.5576-.5566 1.1533-1.7773 1.1533-3.5312 0-1.6963-.2432-2.3291-1.3008-3.3848-.9658-.9658-1.1592-1.2783-1.0342-1.6689.09